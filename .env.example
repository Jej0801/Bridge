# Copy this file to .env and fill in your API keys
# When Supabase variables are absent, Bridge runs entirely on local mock data.

# ===== REQUIRED: Supabase Configuration =====
# Get these from: Project Settings > API in your Supabase dashboard
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ===== OPTIONAL: Python Backend Service =====
# URL for the Python FastAPI backend that handles oEmbed metadata fetching
# Local development: http://localhost:8000
# Production: https://your-backend.railway.app or https://your-backend.render.com
EXPO_PUBLIC_REVIEW_SERVICE_URL=http://localhost:8000

# Instagram oEmbed Access Token (required for Instagram share intent)
# Get from: https://developers.facebook.com/apps/ (create Meta app)
# Without this, Instagram links will fail to fetch metadata (TikTok works without token)
INSTAGRAM_ACCESS_TOKEN=

# ===== OPTIONAL: AI & Enrichment Services =====
# These enable AI-powered spot extraction from social media

# Anthropic Claude API (primary AI extraction)
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# OpenAI for extracting spot details from captions (fallback)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Tavily for web search enrichment (ratings, reviews, photos)
# Get from: https://tavily.com (free tier available)
TAVILY_API_KEY=

# ===== OPTIONAL: Geocoding API (choose ONE) =====
# These enable address -> GPS coordinates conversion

# Option 1: Google Maps Geocoding API
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_MAPS_API_KEY=

# Option 2: Mapbox Geocoding
# Get from: https://account.mapbox.com/access-tokens/
# MAPBOX_ACCESS_TOKEN=
