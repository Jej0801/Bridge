# Database Configuration
# For local development (Docker Compose will use this)
DATABASE_URL=postgresql+asyncpg://bridge:bridge@db:5432/bridge_reviews

# For production (Railway/Render will auto-provide this)
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname

# CORS Origins (comma-separated list)
# Development: allow all
CORS_ORIGINS=*
# Production: specify your Expo app domain
# CORS_ORIGINS=https://yourdomain.com,http://localhost:19006

# Instagram oEmbed API
# Required for Instagram share intent metadata fetching
# Get from: https://developers.facebook.com/apps/
# Create a Meta app → Instagram Basic Display → Generate Access Token
INSTAGRAM_ACCESS_TOKEN=

# Workspace directory (for code review features - optional)
WORKSPACE_DIR=/tmp/bridge-workspaces

# Environment
ENV=development

# App name
APP_NAME=Bridge Share Intent Service
